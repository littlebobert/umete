          }
        }
      }
    },
    "Your AI settings and API key are kept. This can’t be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIの設定とAPIキーは保持されます。この操作は取り消せません。"
          }
