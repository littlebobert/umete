    },
    "Use Remember my answers on a completed form in Safari, or tap + to add an answer here." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safariで入力済みのフォームに対して「回答を保存」を使うか、「+」をタップしてここに回答を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari에서 작성을 마친 양식에 '답변 저장'을 사용하거나, +를 탭하여 여기에서 답변을 추가하세요."
          }
        }
      }
    },
    "Use Remember my answers on a completed form. Later, choose Fill this form to reuse them." : {
      "comment" : "Remember my answers and Fill this form are command names in the Umete Safari extension; use the same translations",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力済みのフォームで「回答を保存」を使います。あとで「このフォームに入力」を選ぶと、回答を再利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작성을 마친 양식에 '답변 저장'을 사용하세요. 나중에 '이 양식 채우기'를 선택하면 답변을 다시 사용할 수 있습니다."
          }
        }
      }
    },
    "Used only when on-device matching cannot identify a field confidently." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上の照合で項目を確実に特定できない場合にのみ使用されます。"
