        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 답변이 이 기기에서 모두 삭제되었으며, 다른 기기에서도 제거됩니다. AI 설정은 유지되었습니다."
          }
