      }
    },
    "Umete is ready" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umeteの準備ができました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umete 준비 완료"
          }
        }
      }
    },
    "Umete keeps your answers encrypted, has no account, and collects no analytics." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umeteは回答を暗号化して保管し、アカウントは不要で、解析データも収集しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umete는 답변을 암호화하여 보관하고, 계정이 없으며, 분석 데이터를 수집하지 않습니다."
          }
        }
      }
    },
    "Umete matches fields on your device first. AI matching is used only for fields it can’t match itself." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umeteはまずデバイス上で項目を照合します。AIマッチングは、Umeteが自分で照合できない項目にのみ使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umete는 먼저 기기에서 항목을 매칭합니다. AI 매칭은 Umete가 직접 매칭할 수 없는 항목에만 사용됩니다."
          }
        }
      }
    },
    "Umete Privacy" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umeteのプライバシー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umete 개인정보 보호"
          }
        }
      }
    },
    "Umete remembers answers you choose and fills similar web forms automatically." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umeteは、選んだ回答を記憶し、似たWebフォームに自動で入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umete는 사용자가 선택한 답변을 기억하고 비슷한 웹 양식을 자동으로 채웁니다."
          }
        }
      }
    },
    "Umete remembers answers you choose and fills similar web forms in Safari. It matches on your device first and uses AI only when needed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umeteは、選んだ回答を記憶し、Safariで似たWebフォームに入力します。まずデバイス上で照合し、必要なときだけAIを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umete는 사용자가 선택한 답변을 기억하고 Safari에서 비슷한 웹 양식을 채웁니다. 먼저 기기에서 매칭하고 필요할 때만 AI를 사용합니다."
          }
        }
      }
    },
    "Umete Settings" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
