        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 설정과 API 키는 유지됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        }
      }
    },
    "Your AI settings are stored securely in Apple Keychain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIの設定はキーチェーンに安全に保管されます。"
