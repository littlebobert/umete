          }
        }
      }
    },
    "Umete is disabled. Enable it in Safari Settings → Extensions." : {
      "comment" : "Safari Settings → Extensions is a menu path in Safari; use Safari's own localized names",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
