{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Answers are encrypted on your devices with a key in your iCloud Keychain, so Apple can’t read them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@回答はiCloudキーチェーン内の鍵を使ってデバイス上で暗号化されるため、Appleが読み取ることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 답변은 iCloud 키체인에 있는 키로 기기에서 암호화되므로 Apple이 읽을 수 없습니다."
          }
        }
      }
    },
    "%lld answers from another device can't be read until that device syncs again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスからの%lld件の回答は、そのデバイスが再度同期するまで読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기의 답변 %lld개는 해당 기기가 다시 동기화될 때까지 읽을 수 없습니다."
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld answer from another device can't be read until that device syncs again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld answers from another device can't be read until that device syncs again."
                }
              }
            }
          }
        }
      }
    },
    "%lld saved answers, encrypted. Tap an answer to edit it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの回答は%lld件で、暗号化されています。回答をタップすると編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 답변 %lld개(암호화됨). 답변을 탭하여 편집하세요."
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld saved answer, encrypted. Tap an answer to edit it."
