        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가 번호를 포함하여 입력하세요(예: +82 10-1234-5678)."
          }
        }
      }
    },
    "Year, month, and day, like 1990-04-12." : {
